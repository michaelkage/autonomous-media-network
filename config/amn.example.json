{
  "sources": {
    "reddit": ["earthporn", "wallpapers"]
  },
  "targets": [
    {
      "id": "telegram-main",
      "platform": "telegram",
      "enabled": false,
      "chat_id": "@your_channel",
      "token_env": "TELEGRAM_BOT_TOKEN"
    },
    {
      "id": "x-main",
      "platform": "x",
      "enabled": false,
      "token_env": "X_USER_ACCESS_TOKEN"
    },
    {
      "id": "facebook-main",
      "platform": "facebook",
      "enabled": false,
      "facebook_page_id": "YOUR_FACEBOOK_PAGE_ID",
      "token_env": "FACEBOOK_PAGE_ACCESS_TOKEN"
    },
    {
      "id": "instagram-main",
      "platform": "instagram",
      "enabled": false,
      "instagram_user_id": "YOUR_IG_PROFESSIONAL_ACCOUNT_ID",
      "public_base_url": "https://media.example.com/outbox",
      "token_env": "INSTAGRAM_ACCESS_TOKEN"
    },
    {
      "id": "tiktok-main",
      "platform": "tiktok",
      "enabled": false,
      "public_base_url": "https://media.example.com/outbox",
      "privacy_level": "SELF_ONLY",
      "direct_post_enabled": false,
      "token_env": "TIKTOK_ACCESS_TOKEN"
    }
  ],
  "storage": null,
  "routes": {
    "default": [],
    "landscape": ["telegram-main", "facebook-main", "x-main", "instagram-main", "tiktok-main"],
    "architecture": ["telegram-main", "instagram-main"],
    "earthporn": ["telegram-main", "instagram-main"],
    "wallpapers": ["telegram-main", "tiktok-main"]
  },
  "thresholds": {
    "min_likes": 500,
    "max_distance": 5
  }
}
